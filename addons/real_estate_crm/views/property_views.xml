<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <!-- Property Form View -->
        <record id="view_property_form" model="ir.ui.view">
            <field name="name">real.estate.property.form</field>
            <field name="model">real.estate.property</field>
            <field name="arch" type="xml">
                <form string="Property">
                    <header>
                        <button name="action_make_available" string="Make Available" type="object" 
                                states="draft" class="btn-primary"/>
                        <button name="action_receive_offer" string="Receive Offer" type="object" 
                                states="available" class="btn-secondary"/>
                        <button name="action_accept_offer" string="Accept Offer" type="object" 
                                states="offer_received" class="btn-primary"/>
                        <button name="action_sell_property" string="Sold" type="object" 
                                states="offer_accepted" class="btn-success"/>
                        <button name="action_cancel_property" string="Cancel" type="object" 
                                states="draft,available,offer_received" class="btn-secondary"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,available,offer_received,offer_accepted,sold"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button class="oe_stat_button" type="object" name="action_get_coordinates" icon="fa-map-marker">
                                <div class="o_field_widget o_stat_info">
                                    <span class="o_stat_text">Get GPS</span>
                                </div>
                            </button>
                        </div>
                        <field name="image_1920" widget="image" class="oe_avatar"/>
                        <div class="oe_title">
                            <h1>
                                <field name="reference" readonly="1"/>
                            </h1>
                            <h2>
                                <field name="name" placeholder="Property Title"/>
                            </h2>
                        </div>
                        <group>
                            <group string="Basic Information">
                                <field name="property_type_id"/>
                                <field name="salesperson_id"/>
                                <field name="seller_id"/>
                                <field name="buyer_id" states="offer_accepted,sold"/>
                                <field name="availability_date"/>
                            </group>
                            <group string="Pricing">
                                <field name="currency_id" invisible="1"/>
                                <field name="expected_price"/>
                                <field name="selling_price" states="offer_accepted,sold"/>
                                <field name="best_price" readonly="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Property Details">
                                <group>
                                    <group string="Rooms">
                                        <field name="bedrooms"/>
                                        <field name="bathrooms"/>
                                        <field name="garage"/>
                                        <field name="garage_spaces" attrs="{'invisible': [('garage', '=', False)]}"/>
                                    </group>
                                    <group string="Areas">
                                        <field name="living_area"/>
                                        <field name="total_area"/>
                                        <field name="garden_area"/>
                                        <field name="total_area_display" readonly="1"/>
                                    </group>
                                </group>
                                <group string="Features">
                                    <field name="property_features" widget="many2many_tags"/>
                                </group>
                                <group string="Description">
                                    <field name="description" nolabel="1"/>
                                </group>
                            </page>
                            <page string="Location">
                                <group>
                                    <group string="Address">
                                        <field name="street"/>
                                        <field name="street2"/>
                                        <field name="city"/>
                                        <field name="state_id"/>
                                        <field name="zip_code"/>
                                        <field name="country_id"/>
                                        <field name="full_address" readonly="1"/>
                                    </group>
                                    <group string="GPS Coordinates">
                                        <field name="latitude"/>
                                        <field name="longitude"/>
                                    </group>
                                </group>
                            </page>
                            <page string="Images &amp; Documents">
                                <group>
                                    <field name="property_images" nolabel="1">
                                        <tree editable="bottom">
                                            <field name="sequence" widget="handle"/>
                                            <field name="name"/>
                                            <field name="image_128" widget="image"/>
                                            <field name="description"/>
                                        </tree>
                                    </field>
                                </group>
                                <group>
                                    <field name="property_documents" nolabel="1">
                                        <tree editable="bottom">
                                            <field name="name"/>
                                            <field name="document_type"/>
                                            <field name="document" filename="document_filename"/>
                                            <field name="document_filename" invisible="1"/>
                                            <field name="is_public"/>
                                        </tree>
                                    </field>
                                </group>
                            </page>
                            <page string="Offers">
                                <field name="offer_ids" nolabel="1">
                                    <tree editable="bottom">
                                        <field name="partner_id"/>
                                        <field name="price"/>
                                        <field name="validity"/>
                                        <field name="date_deadline"/>
                                        <field name="status"/>
                                        <button name="action_accept" string="Accept" type="object" 
                                                states="pending" class="btn-success"/>
                                        <button name="action_refuse" string="Refuse" type="object" 
                                                states="pending" class="btn-secondary"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Appointments">
                                <field name="appointment_ids" nolabel="1">
                                    <tree>
                                        <field name="name"/>
                                        <field name="appointment_date"/>
                                        <field name="client_id"/>
                                        <field name="agent_id"/>
                                        <field name="state"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>
        
        <!-- Property Tree View -->
        <record id="view_property_tree" model="ir.ui.view">
            <field name="name">real.estate.property.tree</field>
            <field name="model">real.estate.property</field>
            <field name="arch" type="xml">
                <tree string="Properties">
                    <field name="reference"/>
                    <field name="name"/>
                    <field name="property_type_id"/>
                    <field name="city"/>
                    <field name="bedrooms"/>
                    <field name="bathrooms"/>
                    <field name="living_area"/>
                    <field name="expected_price"/>
                    <field name="salesperson_id"/>
                    <field name="state" decoration-info="state == 'draft'" 
                           decoration-success="state == 'available'" 
                           decoration-warning="state == 'offer_received'" 
                           decoration-primary="state == 'offer_accepted'"
                           decoration-muted="state in ('sold', 'cancelled')"/>
                    <field name="days_on_market"/>
                </tree>
            </field>
        </record>
        
        <!-- Property Kanban View -->
        <record id="view_property_kanban" model="ir.ui.view">
            <field name="name">real.estate.property.kanban</field>
            <field name="model">real.estate.property</field>
            <field name="arch" type="xml">
                <kanban string="Properties" default_group_by="state">
                    <field name="id"/>
                    <field name="name"/>
                    <field name="expected_price"/>
                    <field name="currency_id"/>
                    <field name="bedrooms"/>
                    <field name="bathrooms"/>
                    <field name="city"/>
                    <field name="state"/>
                    <field name="image_medium"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_card oe_kanban_global_click">
                                <div class="oe_kanban_content">
                                    <div class="row">
                                        <div class="col-6">
                                            <img t-att-src="kanban_image('real.estate.property', 'image_medium', record.id.raw_value)" 
                                                 class="oe_kanban_image" alt="Property"/>
                                        </div>
                                        <div class="col-6">
                                            <div class="oe_kanban_details">
                                                <strong class="o_kanban_record_title">
                                                    <field name="name"/>
                                                </strong>
                                                <ul>
                                                    <li>
                                                        <field name="expected_price" widget="monetary"/>
                                                    </li>
                                                    <li>
                                                        <i class="fa fa-bed"/> <field name="bedrooms"/> beds
                                                        <i class="fa fa-bath"/> <field name="bathrooms"/> baths
                                                    </li>
                                                    <li>
                                                        <i class="fa fa-map-marker"/> <field name="city"/>
                                                    </li>
                                                </ul>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>
        
        <!-- Property Search View -->
        <record id="view_property_search" model="ir.ui.view">
            <field name="name">real.estate.property.search</field>
            <field name="model">real.estate.property</field>
            <field name="arch" type="xml">
                <search string="Properties">
                    <field name="name" string="Property" filter_domain="[('name', 'ilike', self)]"/>
                    <field name="reference"/>
                    <field name="property_type_id"/>
                    <field name="city"/>
                    <field name="salesperson_id"/>
                    <field name="seller_id"/>
                    <separator/>
                    <filter string="Available" name="available" domain="[('state', '=', 'available')]"/>
                    <filter string="Offer Received" name="offer_received" domain="[('state', '=', 'offer_received')]"/>
                    <filter string="Sold" name="sold" domain="[('state', '=', 'sold')]"/>
                    <separator/>
                    <filter string="My Properties" name="my_properties" domain="[('salesperson_id', '=', uid)]"/>
                    <separator/>
                    <filter string="With Garden" name="with_garden" domain="[('garden_area', '>', 0)]"/>
                    <filter string="With Garage" name="with_garage" domain="[('garage', '=', True)]"/>
                    <group expand="1" string="Group By">
                        <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                        <filter string="Property Type" name="group_type" context="{'group_by': 'property_type_id'}"/>
                        <filter string="Salesperson" name="group_salesperson" context="{'group_by': 'salesperson_id'}"/>
                        <filter string="City" name="group_city" context="{'group_by': 'city'}"/>
                    </group>
                </search>
            </field>
        </record>
        
        <!-- Property Action -->
        <record id="action_property" model="ir.actions.act_window">
            <field name="name">Properties</field>
            <field name="res_model">real.estate.property</field>
            <field name="view_mode">tree,kanban,form</field>
            <field name="context">{'search_default_available': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first property listing!
                </p>
                <p>
                    Add property details, photos, and start managing your real estate portfolio.
                </p>
            </field>
        </record>
        
    </data>
</odoo>