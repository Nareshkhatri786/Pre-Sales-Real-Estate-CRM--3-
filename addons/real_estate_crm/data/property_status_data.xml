<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- Lead Stages -->
        <record id="stage_new" model="real.estate.lead.stage">
            <field name="name">New</field>
            <field name="description">New lead, not yet contacted</field>
            <field name="sequence">1</field>
            <field name="fold" eval="False"/>
            <field name="is_won" eval="False"/>
            <field name="is_lost" eval="False"/>
            <field name="requirements">Lead received, initial information captured</field>
        </record>
        
        <record id="stage_contacted" model="real.estate.lead.stage">
            <field name="name">Contacted</field>
            <field name="description">Initial contact made with lead</field>
            <field name="sequence">2</field>
            <field name="fold" eval="False"/>
            <field name="is_won" eval="False"/>
            <field name="is_lost" eval="False"/>
            <field name="requirements">First contact made, basic needs identified</field>
        </record>
        
        <record id="stage_qualified" model="real.estate.lead.stage">
            <field name="name">Qualified</field>
            <field name="description">Lead qualified and interested</field>
            <field name="sequence">3</field>
            <field name="fold" eval="False"/>
            <field name="is_won" eval="False"/>
            <field name="is_lost" eval="False"/>
            <field name="requirements">Budget confirmed, timeline established, decision maker identified</field>
        </record>
        
        <record id="stage_meeting_scheduled" model="real.estate.lead.stage">
            <field name="name">Meeting Scheduled</field>
            <field name="description">Meeting or property viewing scheduled</field>
            <field name="sequence">4</field>
            <field name="fold" eval="False"/>
            <field name="is_won" eval="False"/>
            <field name="is_lost" eval="False"/>
            <field name="requirements">Appointment scheduled for property viewing or consultation</field>
        </record>
        
        <record id="stage_property_shown" model="real.estate.lead.stage">
            <field name="name">Property Shown</field>
            <field name="description">Property has been shown to client</field>
            <field name="sequence">5</field>
            <field name="fold" eval="False"/>
            <field name="is_won" eval="False"/>
            <field name="is_lost" eval="False"/>
            <field name="requirements">Property viewing completed, feedback received</field>
        </record>
        
        <record id="stage_negotiation" model="real.estate.lead.stage">
            <field name="name">Negotiation</field>
            <field name="description">In negotiation phase</field>
            <field name="sequence">6</field>
            <field name="fold" eval="False"/>
            <field name="is_won" eval="False"/>
            <field name="is_lost" eval="False"/>
            <field name="requirements">Offer submitted or price negotiation in progress</field>
        </record>
        
        <record id="stage_contract_pending" model="real.estate.lead.stage">
            <field name="name">Contract Pending</field>
            <field name="description">Contract preparation or signatures pending</field>
            <field name="sequence">7</field>
            <field name="fold" eval="False"/>
            <field name="is_won" eval="False"/>
            <field name="is_lost" eval="False"/>
            <field name="requirements">Agreement reached, contract being prepared or signed</field>
        </record>
        
        <record id="stage_won" model="real.estate.lead.stage">
            <field name="name">Won</field>
            <field name="description">Lead converted to sale/rental</field>
            <field name="sequence">8</field>
            <field name="fold" eval="True"/>
            <field name="is_won" eval="True"/>
            <field name="is_lost" eval="False"/>
            <field name="requirements">Contract signed, deal closed successfully</field>
        </record>
        
        <record id="stage_lost" model="real.estate.lead.stage">
            <field name="name">Lost</field>
            <field name="description">Lead lost or cancelled</field>
            <field name="sequence">9</field>
            <field name="fold" eval="True"/>
            <field name="is_won" eval="False"/>
            <field name="is_lost" eval="True"/>
            <field name="requirements">Lead cancelled, client not interested, or lost to competitor</field>
        </record>
        
        <!-- Property Features -->
        <record id="feature_swimming_pool" model="real.estate.property.feature">
            <field name="name">Swimming Pool</field>
            <field name="description">Property has a swimming pool</field>
            <field name="feature_type">exterior</field>
        </record>
        
        <record id="feature_garden" model="real.estate.property.feature">
            <field name="name">Garden</field>
            <field name="description">Property has a garden or landscaping</field>
            <field name="feature_type">exterior</field>
        </record>
        
        <record id="feature_garage" model="real.estate.property.feature">
            <field name="name">Garage</field>
            <field name="description">Property has a garage</field>
            <field name="feature_type">exterior</field>
        </record>
        
        <record id="feature_balcony" model="real.estate.property.feature">
            <field name="name">Balcony</field>
            <field name="description">Property has a balcony or terrace</field>
            <field name="feature_type">exterior</field>
        </record>
        
        <record id="feature_fireplace" model="real.estate.property.feature">
            <field name="name">Fireplace</field>
            <field name="description">Property has a fireplace</field>
            <field name="feature_type">interior</field>
        </record>
        
        <record id="feature_air_conditioning" model="real.estate.property.feature">
            <field name="name">Air Conditioning</field>
            <field name="description">Property has air conditioning system</field>
            <field name="feature_type">interior</field>
        </record>
        
        <record id="feature_central_heating" model="real.estate.property.feature">
            <field name="name">Central Heating</field>
            <field name="description">Property has central heating system</field>
            <field name="feature_type">interior</field>
        </record>
        
        <record id="feature_hardwood_floors" model="real.estate.property.feature">
            <field name="name">Hardwood Floors</field>
            <field name="description">Property has hardwood flooring</field>
            <field name="feature_type">interior</field>
        </record>
        
        <record id="feature_walk_in_closet" model="real.estate.property.feature">
            <field name="name">Walk-in Closet</field>
            <field name="description">Master bedroom has walk-in closet</field>
            <field name="feature_type">interior</field>
        </record>
        
        <record id="feature_updated_kitchen" model="real.estate.property.feature">
            <field name="name">Updated Kitchen</field>
            <field name="description">Recently renovated or modern kitchen</field>
            <field name="feature_type">interior</field>
        </record>
        
        <record id="feature_gym" model="real.estate.property.feature">
            <field name="name">Gym/Fitness Center</field>
            <field name="description">Building or property has gym facilities</field>
            <field name="feature_type">amenity</field>
        </record>
        
        <record id="feature_concierge" model="real.estate.property.feature">
            <field name="name">Concierge Service</field>
            <field name="description">Building has concierge or doorman service</field>
            <field name="feature_type">amenity</field>
        </record>
        
        <record id="feature_elevator" model="real.estate.property.feature">
            <field name="name">Elevator</field>
            <field name="description">Building has elevator access</field>
            <field name="feature_type">amenity</field>
        </record>
        
        <record id="feature_parking" model="real.estate.property.feature">
            <field name="name">Parking Space</field>
            <field name="description">Dedicated parking space included</field>
            <field name="feature_type">amenity</field>
        </record>
        
        <record id="feature_security_system" model="real.estate.property.feature">
            <field name="name">Security System</field>
            <field name="description">Property has security system installed</field>
            <field name="feature_type">security</field>
        </record>
        
        <record id="feature_gated_community" model="real.estate.property.feature">
            <field name="name">Gated Community</field>
            <field name="description">Property is in a gated community</field>
            <field name="feature_type">security</field>
        </record>
        
        <record id="feature_pet_friendly" model="real.estate.property.feature">
            <field name="name">Pet Friendly</field>
            <field name="description">Pets are allowed in the property</field>
            <field name="feature_type">other</field>
        </record>
        
        <record id="feature_furnished" model="real.estate.property.feature">
            <field name="name">Furnished</field>
            <field name="description">Property comes fully furnished</field>
            <field name="feature_type">other</field>
        </record>
        
        <record id="feature_ocean_view" model="real.estate.property.feature">
            <field name="name">Ocean View</field>
            <field name="description">Property has ocean or water view</field>
            <field name="feature_type">other</field>
        </record>
        
        <record id="feature_city_view" model="real.estate.property.feature">
            <field name="name">City View</field>
            <field name="description">Property has city skyline view</field>
            <field name="feature_type">other</field>
        </record>
        
    </data>
</odoo>